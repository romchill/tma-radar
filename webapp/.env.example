# Оставь пустым для прода: фронт и API на одном домене через Caddy.
# Для локальной разработки vite проксирует /api на 127.0.0.1:8000 сам.
VITE_API_BASE=

# Только для разработки вне Telegram: вход без подписи initData.
# На бэкенде при этом должен стоять DEV_MODE=true. Укажи свой telegram user id.
VITE_DEV_USER_ID=
