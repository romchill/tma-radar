# ---------- postgres ----------
# Пароль генерируется при создании .env, менять не нужно.
# Он должен совпадать в POSTGRES_PASSWORD и внутри DATABASE_URL.
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar
DATABASE_URL=postgresql+asyncpg://radar:ЗАМЕНИ_НА_ПАРОЛЬ@db:5432/radar

# ---------- telegram bot (пуши + вход в мини-апп) ----------
# @BotFather -> /newbot -> скопировать токен
BOT_TOKEN=
# твой telegram user id: напиши @userinfobot, он пришлёт число
ADMIN_IDS=

# ---------- сбор из публичных каналов ----------
# Работает без аккаунта, номера и ключей — ничего заполнять не нужно.
# Каналы добавляются командой боту: /add @название_канала
CHANNEL_POLL_INTERVAL_SEC=300
CHANNEL_FETCH_DELAY_SEC=3

# ---------- telegram userbot (НЕОБЯЗАТЕЛЬНО) ----------
# Нужен только чтобы читать группы и закрытые чаты, куда веб-версия не пускает.
# Требует api_id/api_hash с my.telegram.org и ОТДЕЛЬНУЮ сим-карту
# (не основной аккаунт — его могут забанить).
# Пусто = юзербот выключен, лиды собираются только из публичных каналов.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=/app/sessions/collector
# На хостинге диск сбрасывается при каждом передеплое, поэтому там сессия
# хранится строкой. Получить: python -m app.scripts.login (один раз, на своём
# компьютере). Это ПОЛНЫЙ ДОСТУП к аккаунту — только в секреты, никогда в код.
TG_SESSION_STRING=
AUTOENABLE_NEW_SOURCES=true

# ---------- ВКонтакте ----------
# Единственный источник, где у поста есть автор и ему можно написать бесплатно.
# Где взять: vk.com/apps?act=manage -> создать приложение (тип Standalone) ->
# вкладка «Ключи доступа» -> сервисный ключ. Бесплатно, карта не нужна,
# доступа к твоему личному аккаунту НЕ даёт — только чтение открытых данных.
VK_SERVICE_TOKEN=
VK_POLL_INTERVAL_SEC=300

# ---------- anthropic ----------
# ВНИМАНИЕ: это платно и требует привязки карты.
# Без ключа собираться лиды будут, но оценивать их будет некому.
ANTHROPIC_API_KEY=
# скоринг гоняется на каждом пойманном сообщении -> самая дешёвая модель
MODEL_SCORER=claude-haiku-4-5
# первое сообщение клиенту решает конверсию, тут не экономим
MODEL_WRITER=claude-sonnet-5

# ---------- логика ----------
# лид с этим score и выше попадает в ленту
SCORE_THRESHOLD=60
# пуш уходит на каждый лид выше порога; этот балл и выше — пометка «горячий»
# важно: порог должен быть ниже потолка бесплатной оценки (84)
SCORE_HOT=75
# сколько уведомлений в телеграм разрешено за сутки; 0 = без лимита
# лента при этом не режется: всё, что прошло порог, остаётся в приложении
DAILY_LEAD_CAP=15
# не заводить нового лида на того же автора чаще, чем раз в N дней
CONTACT_COOLDOWN_DAYS=30
# сколько сообщений скорер берёт за один проход
SCORER_BATCH=20
SCORER_INTERVAL_SEC=5
LOG_LEVEL=INFO

# ---------- адрес мини-аппа ----------
# Постоянный поддомен на serveo: <имя>.serveo.net. Пока ssh-ключ туннеля
# не зарегистрирован на console.serveo.net — оставить пустым, адрес будет
# временным и кнопки в старых сообщениях будут протухать.
TUNNEL_SUBDOMAIN=
# Домена нет, публичный адрес даёт туннель и он меняется каждый час,
# поэтому здесь ничего не задаём: актуальный адрес присылается боту
# командой /url https://...pinggy.link и хранится в базе.
DOMAIN=

# Все фоновые задачи внутри процесса api. Нужно только там, где разрешён
# один контейнер (бесплатный хостинг). В docker compose здесь false.
RUN_WORKERS_INLINE=false

# ТОЛЬКО для разработки на этом компьютере: вход без подписи Telegram.
# На людях всегда false.
DEV_MODE=false
