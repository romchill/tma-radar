# Локальное окружение разработки: в образе есть свой python и свои пакеты,
# а .venv весит сотни мегабайт и собран под Windows — внутри linux-контейнера
# он всё равно нерабочий.
.venv/
venv/

__pycache__/
*.py[cod]

# Сессия юзербота монтируется томом, а не запекается в образ:
# это ключ от аккаунта, ему в слоях образа не место.
sessions/
*.session
*.session-journal

.env
.pytest_cache/
